PORT=
HOST=0.0.0.0
FFMPEG_PATH=
CAMERA_DEVICE=
ENABLE_AUDIO=false
AUDIO_DEVICE=
VIDEO_WIDTH=1920
VIDEO_HEIGHT=1080
VIDEO_FPS=30
VIDEO_FORMAT=mjpeg
# Quadros por segundo do clipe. A captura continua em VIDEO_FPS.
VIDEO_OUTPUT_FPS=15
# Imagem da aba Live. Nao muda a resolucao do clipe.
PREVIEW_WIDTH=480
PREVIEW_INTERVAL_SECONDS=2
BUFFER_DURATION_SECONDS=30
POST_EVENT_DURATION_SECONDS=3
SEGMENT_DURATION_SECONDS=1
STORAGE_PROVIDER=mock
AWS_REGION=
AWS_S3_BUCKET=
# Botao fisico: virtual (so web) ou gpio (libgpiod/gpiomon)
BUTTON_PROVIDER=virtual
GPIO_CHIP=gpiochip0
GPIO_BUTTON_PIN=
GPIO_ACTIVE_LOW=true
GPIO_DEBOUNCE_MS=50
# Ganho do audio em dB (0 = sem ganho)
AUDIO_GAIN_DB=0
AUDIO_DENOISE=false
# Loga cada segmento gravado (muito verboso)
LOG_VERBOSE=false
# Login da interface
AUTH_USERNAME=admin
AUTH_PASSWORD=admin
AUTH_SESSION_TTL_HOURS=24
# Pre-cadastro da aba de equipamento (camera/botao principal)
EQUIPMENT_MAIN_CAMERA_ID=env-camera-main
EQUIPMENT_MAIN_CAMERA_NAME=Camera principal
EQUIPMENT_MAIN_BUTTON_ID=env-button-main
EQUIPMENT_MAIN_BUTTON_NAME=Botao principal
# Armazenamento
STORAGE_MAX_PERCENT_FREE=50
STORAGE_MAX_BYTES=10737418240
CLOUD_MAX_BYTES=10737418240
STORAGE_RETENTION_INTERVAL_SECONDS=60
# Sincronizacao offline-first (pausa uploads sem internet e retoma ao reconectar)
SYNC_ENABLED=true
SYNC_CONNECTIVITY_URL=https://www.gstatic.com/generate_204
SYNC_CHECK_INTERVAL_SECONDS=30
SYNC_RETRY_INTERVAL_SECONDS=120
# Para Cloudflare R2/B2/MinIO (S3 compativel): STORAGE_PROVIDER=s3 + endpoint
S3_ENDPOINT=
S3_PREFIX=clips
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
